{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "browser-pulse",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": false,
      "invocation_logs": true,
    },
  },
  "routes": [
    {
      "pattern": "browser-pulse.langliu.top",
      "custom_domain": true,
    },
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "browser-pulse",
      "database_id": "8c336d9c-570a-4030-b29d-14893521b73a",
      "migrations_dir": "drizzle",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "browser-pulse-ingest",
      },
    ],
    "consumers": [
      {
        "queue": "browser-pulse-ingest",
        "max_batch_size": 20,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "browser-pulse-ingest-dlq",
      },
    ],
  },
  "ratelimits": [
    {
      "name": "INGEST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
}
