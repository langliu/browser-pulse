# Browser Pulse 环境变量模板
#
# 本地开发：复制本文件为 `.env.local`（已被 .gitignore 排除）并填入真实值，
#   Vite dev server 会将其作为 Cloudflare bindings 的本地 secrets/vars 加载。
# 生产部署：以下变量配置为 Cloudflare Workers 的 Secrets / Vars
#   （`wrangler secret put <NAME>` 或控制台），不要提交真实值到仓库。

# ── 认证（Better Auth）───────────────────────────────────────────────

# 控制台基础 URL。生产必须为 HTTPS 域名，且与 Google Console
# 登记的 OAuth 回调一致（https://<域名>/api/auth/callback/google）。
# 本地示例：http://localhost:3000
BETTER_AUTH_URL=https://browserpulse.example.com

# Better Auth 会话签名密钥。至少 32 字节随机值，生产用强随机数生成：
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# Google OAuth Client ID / Secret（Google Cloud Console 创建 Web 应用凭据）。
# 缺少时登录功能不启用，首页会显示配置提示。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 密钥与签名（采集 / 查询密钥）─────────────────────────────────────

# 采集键 HMAC 签名与查询密钥摘要的加盐密钥。生产用强随机数生成：
#   openssl rand -hex 32
# 一旦启用后不得变更，否则存量 collectorKey / queryApiKey 全部失效。
KEY_PEPPER=

# ── 可选 ──────────────────────────────────────────────────────────────

# 采集端点独立域名（如 https://collector.browserpulse.example）。
# 不设置时默认使用 BETTER_AUTH_URL。
# COLLECTOR_ORIGIN=
